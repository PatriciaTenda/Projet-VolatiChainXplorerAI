# X / Twitter
BEARER_TOKEN=your_x_bearer_token

# Coinbase
SECRET_KEY_COINBASE=your_coinbase_secret_key

# Reddit
CLIENT_ID=your_reddit_client_id
CLIENT_SECRET_REDDIT=your_reddit_client_secret
USER_AGENT=your_reddit_user_agent

# BCE — taux MRO
serie_key_mro=your_mro_series_key
dataset_code_mro=your_mro_dataset_code

# BCE — inflation HICP
key_HICP_V2=your_hicp_series_key
dataset_code_HICP=your_hicp_dataset_code

# BCE — taux de chômage
key_Unemployment=your_unemployment_series_key
dataset_code_Unemployment=your_unemployment_dataset_code

# BCE — masse monétaire M3
serie_key_m3=your_m3_series_key
dataset_code_m3=your_m3_dataset_code

# MongoDB
MONGO_USER=your_mongo_user
MONGO_PASSWORD=your_mongo_password
MONGO_PORT=27017
MONGO_DB=your_mongo_database

# PostgreSQL
POSTGRES_USER=your_postgres_user
POSTGRES_DB=your_postgres_database
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_PORT=5432
POSTGRES_HOST=localhost

# URL de connexion PostgreSQL
URL=postgresql://your_postgres_user:your_postgres_password@localhost:5432/your_postgres_database

# Logs
LOG=INFO
LOG_MYLIB=DEBUG

# Monitoring Discord
DISCORD_WEBHOOK_URL_VOLATICHAINXPLORERAI=your_discord_webhook_url

# Grafana
GRAFANA_ADMIN_USER=your_grafana_admin_user
GRAFANA_ADMIN_PASSWORD=your_grafana_admin_password

# JWT secret key for authentication
JWT_SECRET_KEY=your_jwt_secret_key